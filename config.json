{
  "model": "Temporal Convolutional Network (TCN)",
  "framework": "PyTorch",
  "reference_paper": "Bai, Kolter & Koltun (2018). An Empirical Evaluation of Generic Convolutional and Recurrent Networks for Sequence Modeling. arXiv:1803.01271",
  "reference_code": "https://github.com/locuslab/TCN",
  "random_state": 6200,
  "primary_task": "binary",
  "secondary_task": "five_class",
  "primary_metric": "seizure_class_f1",
  "five_class_primary_metric": "macro_f1",
  "feature_set": "raw_X1_to_X178",
  "input_shape": [1, 178],
  "preprocessing": "z-score with a single mean and SD computed on the training portion of each fold",
  "num_levels": 5,
  "dilations": [1, 2, 4, 8, 16],
  "kernel_size": 5,
  "dropout": 0.2,
  "receptive_field_samples": 249,
  "official_channels": 32,
  "five_class_official_channels": 32,
  "official_class_weight": "none",
  "channel_candidates": [16, 32, 64],
  "class_weight_candidates": [null, "balanced"],
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "batch_size": 64,
  "max_epochs": 60,
  "early_stopping_patience": 8,
  "early_stopping_split": "stratified 10% of the training folds",
  "binary_threshold": 0.5,
  "selection_basis": "five-fold mean seizure-class F1 (binary) and Macro F1 (five-class)",
  "cv_script": "tcn_seizure_en.py",
  "final_test_script": "run_tcn_final_predictions.py",
  "final_test_prediction": "mean probability of the five fold models",
  "final_test_locked": false,
  "final_test_evaluated_once": true
}
